# Copy this file to .env before running locally.
# Supabase is required for the full upload/process/status/results flow.

# Backend (server-side) - use service role or anon key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Frontend (Vite) - anon/public key only; also set these in Vercel project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
